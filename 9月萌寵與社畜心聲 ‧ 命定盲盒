            title: "【技法③ 迷因圖卡】",
            subtitle: "辦公室毒舌貼圖文案",
            text: "「請根據貓狗翻白眼或不屑表情，生成 5 句適合用在辦公室同仁交流的幽默毒舌迷因對白（例如：『這個需求你認真？』、『我的罐罐比你的簡報重要』）。」"
          }
        ]
      }
    };

    let currentStep = 0;
    let scores = { HEAL: 0, FUNNY: 0 };
    let activePersonaKey = "HEAL";
    let activeTabIndex = 0;

    const screenIntro = document.getElementById('screenIntro');
    const screenQuiz = document.getElementById('screenQuiz');
    const screenResult = document.getElementById('screenResult');

    document.getElementById('btnStart').addEventListener('click', () => {
      if (!activeEmpName && !activeEmpId) {
        const val = inputEmpId.value.trim();
        if (!val) {
          document.getElementById('idError').classList.remove('hidden');
          return;
        }
        document.getElementById('idError').classList.add('hidden');
        if (/^\d+$/.test(val)) { activeEmpId = val; } else { activeEmpName = val; }
      }
      screenIntro.classList.add('hidden');
      screenQuiz.classList.remove('hidden');
      renderQuestion();
    });

    function renderQuestion() {
      const q = quizQuestions[currentStep];
      document.getElementById('questionStep').innerText = `QUESTION ${currentStep + 1} / ${quizQuestions.length}`;
      document.getElementById('questionText').innerText = q.question;
      document.getElementById('progressBar').style.width = `${((currentStep + 1) / quizQuestions.length) * 100}%`;

      const container = document.getElementById('optionsContainer');
      container.innerHTML = "";

      q.options.forEach((opt) => {
        const btn = document.createElement('button');
        btn.className = "quiz-option w-full text-left p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200 text-slate-800 text-xs sm:text-sm font-medium hover:text-rose-700 flex items-center justify-between shadow-sm";
        btn.innerHTML = `<span>${opt.label}</span><span class="text-rose-500 font-bold ml-2">→</span>`;
        btn.onclick = () => selectOption(opt.type);
        container.appendChild(btn);
      });
    }

    function selectOption(type) {
      scores[type] = (scores[type] || 0) + 1;
      currentStep++;
      if (currentStep < quizQuestions.length) {
        renderQuestion();
      } else {
        showResult();
      }
    }

    function showResult() {
      screenQuiz.classList.add('hidden');
      screenResult.classList.remove('hidden');

      activePersonaKey = scores.HEAL >= scores.FUNNY ? "HEAL" : "FUNNY";
      const res = quizPersonas[activePersonaKey];

      document.getElementById('resEmoji').innerText = res.emoji;
      document.getElementById('resTag').innerText = res.tag;
      document.getElementById('resTitle').innerText = res.title;
      document.getElementById('resDesc').innerText = res.desc;
      document.getElementById('resProTip').innerText = res.protip;
      document.getElementById('resOwnerBadge').innerText = `報告持有人：${getDisplayName()}`;

      switchTab(0);
      try { confetti({ particleCount: 70, spread: 80, origin: { y: 0.6 } }); } catch (e) {}
    }

    window.switchTab = function(index) {
      activeTabIndex = index;
      const persona = quizPersonas[activePersonaKey];
      const promptObj = persona.prompts[index];

      [0, 1, 2].forEach(i => {
        const btn = document.getElementById(`tab${i}`);
        if (i === index) {
          btn.classList.add('active');
          btn.classList.remove('text-slate-600');
        } else {
          btn.classList.remove('active');
          btn.classList.add('text-slate-600');
        }
      });

      document.getElementById('tabSubtitle').innerText = `${promptObj.title} ${promptObj.subtitle}`;
      document.getElementById('resPromptBox').innerText = promptObj.text;
    };

    document.getElementById('btnCopyPrompt').addEventListener('click', () => {
      const text = document.getElementById('resPromptBox').innerText;
      const copyArea = document.createElement('textarea');
      copyArea.value = text;
      document.body.appendChild(copyArea);
      copyArea.select();
      document.execCommand('copy');
      document.body.removeChild(copyArea);

      const btnText = document.getElementById('copyBtnText');
      btnText.innerText = "已複製當前咒語！";
      setTimeout(() => { btnText.innerText = "一鍵複製當前咒語"; }, 2000);
    });

    document.getElementById('btnRestart').addEventListener('click', () => {
      currentStep = 0;
      scores = { HEAL: 0, FUNNY: 0 };
      screenResult.classList.add('hidden');
      screenQuiz.classList.remove('hidden');
      renderQuestion();
    });
  </script>
</body>
</html>
